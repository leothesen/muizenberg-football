# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# One connection string, for everything. The server connects as the owning role and
# does every write; public page reads drop into the read-only `web_reader` role for
# the length of a transaction, so there is no second credential to manage.
#
# The default below is the local Postgres from docker-compose.yml: `pnpm pg:setup`
# starts it, migrates it and seeds it. In production this is the POOLED Neon endpoint
# — the one with `-pooler` in the host — because a serverless function that opens a
# direct connection per invocation runs out of them.
#
# Vercel's Neon integration sets several names; POSTGRES_URL and the UNPOOLED and
# NON_POOLING variants are all read as fallbacks, so an untouched integration works
# without setting anything here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/muizenberg

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# From @BotFather. Leave unset locally to run against the built-in emulator.
TELEGRAM_BOT_TOKEN=
# Random string; Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token so we
# can prove an inbound webhook really came from Telegram.
TELEGRAM_WEBHOOK_SECRET=XXX
# The group chat the league runs in (negative number for groups).
#
# Required, including locally: the cron routes post to this chat and refuse to run
# without it. The value below is the fake group the emulator and the seed both use,
# so a fresh clone works with no edit. In production it is the real group's id, which
# `getUpdates` gives you before the webhook is set — keep the minus sign.
TELEGRAM_LEAGUE_CHAT_ID=-1001234567890

# Route all outbound Telegram calls to the local emulator instead of api.telegram.org.
TELEGRAM_EMULATOR_ENABLED=true

# ---------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` on cron invocations.
CRON_SECRET=XXX

# Public origin, used to build links back into the web app from Telegram messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs our own session cookie once Telegram has proved who you are. Any long
# random string; changing it logs everybody out.
SESSION_SECRET=XXX

# Telegram OAuth, for logging in from a desktop browser. Both come from @BotFather
# under the bot's "Login Widget" settings, where the allowed redirect URLs are also
# registered. Leave unset and the web login simply says it is switched off — the
# Mini App does not need any of this.
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=

# Local only: signs stand-in Mini App initData so the login can be exercised without
# a real bot. Ignored the moment TELEGRAM_BOT_TOKEN is set or NODE_ENV=production.
TELEGRAM_DEV_BOT_TOKEN=
