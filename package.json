{
  "name": "muizenberg-football",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:start": "supabase start --exclude vector",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset || supabase start --exclude vector",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "geist": "^1.3.1",
    "lucide-react": "^0.436.0",
    "next": "16.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.10.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.17",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.3",
    "postcss": "8.4.33",
    "prettier": "^3.3.3",
    "supabase": "^2.76.16",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    }
  }
}
